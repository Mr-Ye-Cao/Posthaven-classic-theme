<!DOCTYPE html>
<html class='no-js'>
  <head>
    <title>{{ request.page_title }}</title>

    <meta content='width=device-width,initial-scale=1' name='viewport'>

    {{ meta_tags }}

    <link href="{{ 'images/favicon.ico' | asset_url }}" rel='shortcut icon' type='image/x-icon'>
    <link href="//fonts.googleapis.com/css?family=Oxygen:400,700,300|Crimson+Text:400,400italic&amp;subset=latin,latin-ext"
          media="screen" rel="stylesheet" type="text/css" />
    {{ 'blog.css' | asset_url | stylesheet_tag }}

    {{ posthaven.includes_for_head }}
  </head>

  <body id='site_{{ site.id }}'>
    <div id='container'>
      <div id='flash'>
        {% for alert in posthaven.alerts %}
          <div class="alert alert-{{ alert.type }}">
            {{ alert.message }}
          </div>
        {% endfor %}
      </div>

      {% unless hide_header %}
        <header id='header'>
        <div class="header-flex">
          <h1>
            <a href="{{ site.url }}">{{ site.name | smarty_pants }}</a>
          </h1>
          <div id="language-toggle" class="language-tab">
            <button onclick="toggleLanguage('en')">[Eng]</button>
            <button onclick="toggleLanguage('zh')">[文]</button>
          </div>
        </div>

          {% if site.description %}
            <h2>{{ site.description | smarty_pants }}</h2>
          {% endif %}

          {% if subhead_content %}
            <section class="subhead">
              {{ subhead_content }}

              <div class="back-to-blog">
                <a href="{{ site.url }}">&laquo;&nbsp;Back to blog</a>
              </div>
            </section>
          {% elsif show_back_to_blog %}
            <div class="back-to-blog">
              <a href="{{ site.url }}">&laquo;&nbsp;Back to blog</a>
            </div>
          {% endif %}
        </header>
      {% endunless %}

      <div id='main_container'>
        {{ content_for_layout }}
      </div>
    </div>

    {{ posthaven.includes_for_body }}

    <!-- JavaScript for Language Toggle -->
    <script>
      function toggleLanguage(lang) {
        // Get English and Chinese content containers
        const enContent = document.getElementById('content-en-post');
        const zhContent = document.getElementById('content-zh-post');
        
        if (lang === 'en') {
          enContent.style.display = 'block';
          zhContent.style.display = 'none';
        } else if (lang === 'zh') {
          enContent.style.display = 'none';
          zhContent.style.display = 'block';
        }

        // Highlight the active language button
        const engButton = document.querySelector("[onclick='toggleLanguage(\"en\")']");
        const zhButton = document.querySelector("[onclick='toggleLanguage(\"zh\")']");
        
        engButton.classList.toggle('active', lang === 'en');
        zhButton.classList.toggle('active', lang === 'zh');
      }

      // Initialize English as default when page loads
      document.addEventListener('DOMContentLoaded', function() {
        toggleLanguage('en');
      });
    </script>
  </body>
</html>
