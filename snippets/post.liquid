{% if post %}
  {% if post.post_image %}
    {% if post.url.current_page? %}
      <figure>
        <img src="{{ post.post_image.large.url }}" />
      </figure>
    {% else %}
      <figure>
        <a href="{{ post.url }}">
          <img src="{{ post.post_image.large.url }}" />
        </a>
      </figure>
    {% endif %}
  {% endif %}

  <header>
    {% if post.private? %}
      <div class="right private-indicator">
        <span class="lock-icon hint hint--left" data-hint="This post is private. Only you and people you've sent the link to have access to this post."></span>
      </div>
    {% endif %}

    <div class="post-title">
      <h2><a href="{{ post.url }}">{{ post.title }}</a></h2>

      {% if request.template == 'post' and post.show_byline? %}
        <div class="author">
          by
          {% if post.author.url %}
            <a href="{{ post.author.url }}">{{ post.author.name }}</a>
          {% else %}
            {{ post.author.name }}
          {% endif %}
        </div>
      {% endif %}
    </div>
  </header>

  <div class="post-body" id="post_body_{{ post.id }}">
    <!-- English Content -->
    <div id="content-en-{{ post.id }}" class="language-content">
      {{ post.body }} <!-- Display the original English content -->
    </div>

    <!-- Chinese Content -->
    <div id="content-zh-{{ post.id }}" class="language-content" style="display: none;">
      {% if post.custom_fields.chinese_content %}
        {{ post.custom_fields.chinese_content }}
      {% else %}
        这条内容中文翻译不存在。
      {% endif %}
    </div>
  </div>
{% endif %}
