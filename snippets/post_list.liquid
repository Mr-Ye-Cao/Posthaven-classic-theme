<div id="main">
  {% if posts == empty and request.template != 'homepage' %}
    <h2>No posts found.</h2>
  {% endif %}

  {% for post in posts %}
    <article class="post">
      {% include 'post' %}

      <footer class="homepage-post-footer">
        {% unless post.tags == empty %}
          <div class="tags">
            <h6>Tags</h6>
            <ul>
              {% for post_tag in post.tags %}
                <li>
                  <a href="{{ post_tag.url }}">{{ post_tag.name }}</a>
                </li>
              {% endfor %}
            </ul>
          </div>
        {% endunless %}

        {{ post | share_buttons }}
        <a
          href="https://x.com/intent/post?original_referer={{ post.url | append: '' | url_encode }}&ref_src=twsrc%5Etfw%7Ctwcamp%5Ebuttonembed%7Ctwterm%5Eshare%7Ctwgr%5E&text={{ post.title | append: '' | url_encode }}&url={{ post.url | append: '' | url_encode }}"
          target="_blank"
          class="subscribe-button post-share-button"
          style="background-color: black; color: white; border-color: black; text-decoration: none !important;"
        >
          <svg style="height: 12px; width: 12px; margin-right: 4px; vertical-align: middle; fill: white;" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M13.6823 10.6218L20.2391 3H18.6854L12.9921 9.61788L8.44486 3H3.2002L10.0765 13.0074L3.2002 21H4.75404L10.7663 14.0113L15.5549 21H20.7996L13.6819 10.6218H13.6823ZM11.5541 13.0956L10.8574 12.0991L5.31391 4.16971H7.70053L12.1742 10.5689L12.8709 11.5655L18.6861 19.8835H16.2995L11.5541 13.096V13.0956Z"/></svg>
          X Post
        </a>

        {% if site.comments_enabled? and post.response_count > 0 %}
          <span class="response-count">
            <a href="{{ post.url }}">
              {{ post.response_count | pluralize: 'response' }}
            </a>
          </span>

          <span class="slash-divider">&nbsp;&nbsp;//&nbsp;&nbsp;</span>
        {% endif %}

        <span class="display-date">
          Posted
          <a href="{{ post.url }}">{{ post.published_at | relative_date }}</a>
          {% if post.show_byline? %}
            by
            {% if post.author.url %}
              <a href="{{ post.author.url }}">{{ post.author.name }}</a>
            {% else %}
              {{ post.author.name }}
            {% endif %}
          {% endif %}
        </span>
      </footer>
    </article>
  {% endfor %}

  {% if posts.pagination %}
    <div class="pagination">
      {% default_pagination %}
    </div>
  {% endif %}
</div>

<aside id='sidebar'>
  {% include 'nav_menu' %}
  {% include 'bio' %}

  <section class="search-archive">
    {% form 'archive' %}

     <div class="archive-link">
       <a href="{{ site.archive_url }}">Browse the Archive&nbsp;&raquo;</a>
     </div>
  </section>

  {% include 'contributors_section' %}

  {% if site.tags != empty %}
    <section id="tag_list_menu">
      <h3>Tags</h3>

      <ul>
        {% for t in site.tags limit:10 %}
          <li>
            {% if tag and tag == t.name %}
              <strong>{{ t.name }}</strong>
              <span class="measure tag-count">{{ t.post_count }}</span>
            {% else %}
              <a href="{{ t.url }}">{{ t.name }}</a>
              <span class="measure tag-count">{{ t.post_count }}</span>
            {% endif %}
          </li>
        {% endfor %}

        {% if site.tags.size > 10 %}
          <li>
            <a href="{{ site.tags_url }}">
              See all {{ site.tags.size }} tags&nbsp;&raquo;
            </a>
          </li>
        {% endif %}
      </ul>
    </section>
  {% endif %}

  {% include 'blogroll' %}
  {% include 'feed' %}
</aside>
