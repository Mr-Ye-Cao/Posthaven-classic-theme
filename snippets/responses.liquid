<div class="post-responses">
  {{ post | share_buttons }}
  <a
    href="https://x.com/intent/post?original_referer={{ post.url | append: '' | url_encode }}&ref_src=twsrc%5Etfw%7Ctwcamp%5Ebuttonembed%7Ctwterm%5Eshare%7Ctwgr%5E&text={{ post.title | append: '' | url_encode }}&url={{ post.url | append: '' | url_encode }}"
    target="_blank"
    class="subscribe-button post-share-button"
    style="background-color: black; color: white; border-color: black; text-decoration: none !important;"
  >
    <svg style="height: 12px; width: 12px; margin-right: 4px; vertical-align: middle; fill: white;" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M13.6823 10.6218L20.2391 3H18.6854L12.9921 9.61788L8.44486 3H3.2002L10.0765 13.0074L3.2002 21H4.75404L10.7663 14.0113L15.5549 21H20.7996L13.6819 10.6218H13.6823ZM11.5541 13.0956L10.8574 12.0991L5.31391 4.16971H7.70053L12.1742 10.5689L12.8709 11.5655L18.6861 19.8835H16.2995L11.5541 13.096V13.0956Z"/></svg>
    X Post
  </a>

  {% if site.comments_enabled? or post.response_count > 0 %}
    <div class="count">
      <span class="comment-icon"></span>
      {{ post.response_count | pluralize: 'response' }}
    </div>
    <div class="responses">
      {% for response in post.responses %}
        {% include 'response' %}
      {% endfor %}
      {% if post.anon_upvote_count > 0 %}
        <div class="response">
          <div class="upvote">
            {{ post.anon_upvote_count | pluralize: 'visitor' }}
            upvoted this post.
          </div>
        </div>
      {% endif %}
    </div>
  {% endif %}
</div>
